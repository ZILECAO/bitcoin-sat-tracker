+def http_with_retries(do_request, retries=3, backoff=1.0):
+    """Generic bounded retry wrapper (HALO suggestion)."""
+    for attempt in range(retries):
+        try:
+            return do_request()
+        except requests.exceptions.RequestException:
+            if attempt == retries - 1:
+                raise
+            time.sleep(backoff * (2 ** attempt) + _diligence_random.uniform(0, 0.5))
